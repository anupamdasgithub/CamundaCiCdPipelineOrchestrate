<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="cicdBlueprintDefinitionsSM" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="87181d3" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0" camunda:diagramRelationId="c1103ead-75a7-4c07-9ae3-115d8d7a645c">
  <bpmn:process id="cicdGithubJenkinsBlueprintSM" name="CI/CD Blueprint: GitHub -Jenkins(Self-Managed)" isExecutable="true">
    <bpmn:documentation>A customizable process development lifecycle that begins when Web Modeler changes are complete and ends when the process and all other dependencies in the Web Modeler folder are released to production.

For more information, read https://docs.camunda.io/docs/guides/devops-lifecycle/integrate-web-modeler-in-ci-cd/</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="startCicd" name="CI/CD pipeline started">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;http://web-modeler-restapi:8081&#34;" target="modelerBaseUrl" />
          <zeebe:output source="=&#34;http://host.docker.internal:8080&#34;" target="jenkinsBaseUrl" />
          <zeebe:output source="=&#34;camunda-deploy&#34;" target="jenkinsJob" />
          <zeebe:output source="=&#34;http://keycloak:18080/auth/realms/camunda-platform/protocol/openid-connect/token&#34;" target="modelerTokenUrl" />
        </zeebe:ioMapping>
        <zeebe:formDefinition formId="CICDPipelineStart" />
        <zeebe:properties>
          <zeebe:property name="publicAccess" value="false" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_14ymik0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="openMergeRequestSubprocess" name="Open GitHub PR">
      <bpmn:documentation>Creates a branch, adds or updates the files collected the previous steps, and creates a merge request. </bpmn:documentation>
      <bpmn:incoming>Flow_0i10vtb</bpmn:incoming>
      <bpmn:outgoing>Flow_0cray7s</bpmn:outgoing>
      <bpmn:startEvent id="startOpenMergeRequest" name="Start of merge request generation">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=&#34;camunda-modeler/&#34; + folder.metadata.id + &#34;-&#34; + replace(folder.metadata.name, &#34;( |\:)&#34;, &#34;-&#34;)" target="newBranchName" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_1p2kaz7</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="endOpenMergeRequest" name="End of merge request generation">
        <bpmn:incoming>Flow_0ilq3am</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="checkFileStatus" name="Check file status">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=null" target="existingFile" />
            <zeebe:input source="=null" target="sanitizedFilePath" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0oj7qx9</bpmn:incoming>
        <bpmn:outgoing>Flow_1g3f3an</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=fileDetailList" inputElement="fileDetail" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
        <bpmn:startEvent id="startRepositoryFileModification" name="Start repository file modification">
          <bpmn:extensionElements>
            <zeebe:ioMapping>
              <zeebe:output source="=replace(replace(fileDetail.metadata.simplePath, &#34;^/&#34;, &#34;&#34;), &#34; &#34;, &#34;%20&#34;)" target="sanitizedFilePath" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:outgoing>Flow_1yesxbr</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="checkFileExists" name="Check if file already exists">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" />
            <zeebe:ioMapping>
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="={&#34;Authorization&#34;: &#34;Bearer {{ secrets.GITHUB_PAT }}&#34;, &#34;Accept&#34;: &#34;application/vnd.github+json&#34;, &#34;X-GitHub-Api-Version&#34;: &#34;2022-11-28&#34;}" target="headers" />
              <zeebe:input source="=githubApiBaseUrl + &#34;/repos/&#34; + githubOwner + &#34;/&#34; + githubRepo + &#34;/contents/&#34; + sanitizedFilePath" target="url" />
              <zeebe:input source="={&#34;ref&#34;: newBranchName}" target="queryParameters" />
              <zeebe:input source="20" target="connectionTimeoutInSeconds" />
              <zeebe:input source="{{ secrets.GITHUB_PAT }}" target="githubToken" />
              <zeebe:input source="GET" target="method" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={existingFile: response.body}" />
              <zeebe:header key="errorExpression" value="=if error.code = &#34;404&#34; then&#10;  bpmnError(&#34;404&#34;, &#34;File doesn&#39;t exist yet&#34;)&#10;else&#10;  null" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1yesxbr</bpmn:incoming>
          <bpmn:outgoing>Flow_14c5u53</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="updateRepositoryFile" name="Update repository file">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" />
            <zeebe:ioMapping>
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="={&#34;Authorization&#34;: &#34;Bearer {{ secrets.GITHUB_PAT }}&#34;, &#34;Accept&#34;: &#34;application/vnd.github+json&#34;, &#34;X-GitHub-Api-Version&#34;: &#34;2022-11-28&#34;}" target="headers" />
              <zeebe:input source="=githubApiBaseUrl + &#34;/repos/&#34; + githubOwner + &#34;/&#34; + githubRepo + &#34;/contents/&#34; + sanitizedFilePath" target="url" />
              <zeebe:input source="={&#34;message&#34;: &#34;Camunda Web Modeler CI/CD: &#34; + fileDetail.metadata.name, &#34;content&#34;: to base64(fileDetail.content), &#34;branch&#34;: newBranchName, &#34;sha&#34;: existingFile.sha}" target="body" />
              <zeebe:input source="20" target="connectionTimeoutInSeconds" />
              <zeebe:input source="{{ secrets.GITHUB_PAT }}" target="githubToken" />
              <zeebe:input source="PUT" target="method" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_14c5u53</bpmn:incoming>
          <bpmn:outgoing>Flow_1eyxbym</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="joinRepositofyFile">
          <bpmn:incoming>Flow_1eyxbym</bpmn:incoming>
          <bpmn:incoming>Flow_16ry3vq</bpmn:incoming>
          <bpmn:outgoing>Flow_11yblik</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:boundaryEvent id="fileNotFoundBoundaryEvent" name="File not found" attachedToRef="checkFileExists">
          <bpmn:outgoing>Flow_1xy4jx8</bpmn:outgoing>
          <bpmn:errorEventDefinition id="ErrorEventDefinition_1kxrs6h" errorRef="Error_0u4w06y" />
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_14c5u53" sourceRef="checkFileExists" targetRef="updateRepositoryFile" />
        <bpmn:sequenceFlow id="Flow_1xy4jx8" sourceRef="fileNotFoundBoundaryEvent" targetRef="createRepositoryFile" />
        <bpmn:sequenceFlow id="Flow_1eyxbym" sourceRef="updateRepositoryFile" targetRef="joinRepositofyFile" />
        <bpmn:sequenceFlow id="Flow_1yesxbr" sourceRef="startRepositoryFileModification" targetRef="checkFileExists" />
        <bpmn:endEvent id="endRepositoryFileModification" name="End repository file modification">
          <bpmn:incoming>Flow_11yblik</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_11yblik" sourceRef="joinRepositofyFile" targetRef="endRepositoryFileModification" />
        <bpmn:serviceTask id="createRepositoryFile" name="Create new repository file">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" />
            <zeebe:ioMapping>
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="={&#34;Authorization&#34;: &#34;Bearer {{ secrets.GITHUB_PAT }}&#34;, &#34;Accept&#34;: &#34;application/vnd.github+json&#34;, &#34;X-GitHub-Api-Version&#34;: &#34;2022-11-28&#34;}" target="headers" />
              <zeebe:input source="=githubApiBaseUrl + &#34;/repos/&#34; + githubOwner + &#34;/&#34; + githubRepo + &#34;/contents/&#34; + sanitizedFilePath" target="url" />
              <zeebe:input source="={&#34;message&#34;: &#34;Camunda Web Modeler CI/CD: &#34; + fileDetail.metadata.name, &#34;content&#34;: to base64(fileDetail.content), &#34;branch&#34;: newBranchName}" target="body" />
              <zeebe:input source="20" target="connectionTimeoutInSeconds" />
              <zeebe:input source="{{ secrets.GITHUB_PAT }}" target="githubToken" />
              <zeebe:input source="PUT" target="method" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1xy4jx8</bpmn:incoming>
          <bpmn:outgoing>Flow_16ry3vq</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_16ry3vq" sourceRef="createRepositoryFile" targetRef="joinRepositofyFile" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_1p2kaz7" sourceRef="startOpenMergeRequest" targetRef="getBaseBranchSha" />
      <bpmn:sequenceFlow id="Flow_1g3f3an" sourceRef="checkFileStatus" targetRef="openMergeRequest" />
      <bpmn:serviceTask id="getBaseBranchSha" name="Get base branch SHA">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="{{ secrets.GITHUB_PAT }}" target="githubToken" />
            <zeebe:input source="={&#34;Authorization&#34;: &#34;Bearer {{ secrets.GITHUB_PAT }}&#34;, &#34;Accept&#34;: &#34;application/vnd.github+json&#34;, &#34;X-GitHub-Api-Version&#34;: &#34;2022-11-28&#34;}" target="headers" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=githubApiBaseUrl + &#34;/repos/&#34; + githubOwner + &#34;/&#34; + githubRepo + &#34;/git/ref/heads/&#34; + baseBranch" target="url" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultExpression" value="={baseBranchSha: response.body.object.sha}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1p2kaz7</bpmn:incoming>
        <bpmn:outgoing>Flow_toCreateBranch</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_toCreateBranch" sourceRef="getBaseBranchSha" targetRef="createBranch" />
      <bpmn:serviceTask id="createBranch" name="Create branch">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="={&#34;Authorization&#34;: &#34;Bearer {{ secrets.GITHUB_PAT }}&#34;, &#34;Accept&#34;: &#34;application/vnd.github+json&#34;, &#34;X-GitHub-Api-Version&#34;: &#34;2022-11-28&#34;}" target="headers" />
            <zeebe:input source="=githubApiBaseUrl + &#34;/repos/&#34; + githubOwner + &#34;/&#34; + githubRepo + &#34;/git/refs&#34;" target="url" />
            <zeebe:input source="={&#34;ref&#34;: &#34;refs/heads/&#34; + newBranchName, &#34;sha&#34;: baseBranchSha}" target="body" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="{{ secrets.GITHUB_PAT }}" target="githubToken" />
            <zeebe:input source="POST" target="method" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_toCreateBranch</bpmn:incoming>
        <bpmn:outgoing>Flow_0oj7qx9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0oj7qx9" sourceRef="createBranch" targetRef="checkFileStatus" />
      <bpmn:serviceTask id="openMergeRequest" name="Open pull request for branch">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="={&#34;Authorization&#34;: &#34;Bearer {{ secrets.GITHUB_PAT }}&#34;, &#34;Accept&#34;: &#34;application/vnd.github+json&#34;, &#34;X-GitHub-Api-Version&#34;: &#34;2022-11-28&#34;}" target="headers" />
            <zeebe:input source="=githubApiBaseUrl + &#34;/repos/&#34; + githubOwner + &#34;/&#34; + githubRepo + &#34;/pulls&#34;" target="url" />
            <zeebe:input source="={&#34;title&#34;: &#34;CI/CD Review: &#34; + folder.metadata.name, &#34;head&#34;: newBranchName, &#34;base&#34;: baseBranch, &#34;body&#34;: &#34;Changes submitted via Camunda Web Modeler CI/CD blueprint\n\n&#34; + string join(for fileDetail in fileDetailList return (if fileDetail.diffingLink != null then &#34;[Visual comparison of changes to &#34; + fileDetail.metadata.name + &#34;](&#34; + fileDetail.diffingLink + &#34;)&#34; else &#34;&#34;), &#34;\n\n&#34;)}" target="body" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="{{ secrets.GITHUB_PAT }}" target="githubToken" />
            <zeebe:input source="POST" target="method" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultExpression" value="={createdMergeRequest: response.body}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1g3f3an</bpmn:incoming>
        <bpmn:outgoing>Flow_0ilq3am</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0ilq3am" sourceRef="openMergeRequest" targetRef="endOpenMergeRequest" />
      <bpmn:textAnnotation id="TextAnnotation_0cxdibw">
        <bpmn:text>This is the biggest difference to Git Sync. Instead of creating merge requests, changes are directly pushed to the branch</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_1ee1c6r" associationDirection="None" sourceRef="startOpenMergeRequest" targetRef="TextAnnotation_0cxdibw" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_14ymik0" sourceRef="startCicd" targetRef="getFileMetadata" />
    <bpmn:subProcess id="getFileMetadata" name="Retrieve file metadata from Web Modeler API">
      <bpmn:documentation>Uses the Web Modeler API to retrieve the contents of a given folder, creating milestones, and creating milestone comparison links for easier review.</bpmn:documentation>
      <bpmn:incoming>Flow_14ymik0</bpmn:incoming>
      <bpmn:outgoing>Flow_0i10vtb</bpmn:outgoing>
      <bpmn:serviceTask id="getWebModelerToken" name="Get Web Modeler API token">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=modelerTokenUrl" target="url" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="20" target="readTimeoutInSeconds" />
            <zeebe:input source="={grant_type: &#34;client_credentials&#34;, client_id: &#34;{{ secrets.WEB_MODELER_CLIENT_ID }}&#34;, client_secret: &#34;{{ secrets.WEB_MODELER_CLIENT_SECRET }}&#34;}" target="body" />
            <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/x-www-form-urlencoded&#34;}" target="headers" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultExpression" value="={webModelerToken: response.body.access_token}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_07vb2t3</bpmn:incoming>
        <bpmn:outgoing>Flow_02a2jk2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:startEvent id="startFileMetadata" name="Start retrieve file metadata">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="={}" target="milestoneLists" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_07vb2t3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_07vb2t3" sourceRef="startFileMetadata" targetRef="getWebModelerToken" />
      <bpmn:sequenceFlow id="Flow_02a2jk2" sourceRef="getWebModelerToken" targetRef="getFolderDetails" />
      <bpmn:serviceTask id="getFolderDetails" name="Get folder detail">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="bearer" target="authentication.type" />
            <zeebe:input source="=webModelerToken" target="authentication.token" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=modelerBaseUrl + &#34;/api/v1/folders/&#34; + folderId" target="url" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultExpression" value="={folder: response.body}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_02a2jk2</bpmn:incoming>
        <bpmn:outgoing>Flow_03kaw3v</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:subProcess id="getFileDetails" name="Get file details">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=null" target="latestMilestoneId" />
            <zeebe:input source="=null" target="createdMilestoneId" />
            <zeebe:input source="=null" target="diffingLink" />
            <zeebe:input source="=null" target="content" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_03kaw3v</bpmn:incoming>
        <bpmn:outgoing>Flow_10audoq</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics>
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=folder.content.files" inputElement="file" outputCollection="fileDetailList" outputElement="={metadata: file, content: content, diffingLink: diffingLink}" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
        <bpmn:startEvent id="startFileMetadataSubprocess" name="Start file metadata subtasks">
          <bpmn:extensionElements />
          <bpmn:outgoing>Flow_1hdkuop</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:parallelGateway id="splitCallWebModeler">
          <bpmn:incoming>Flow_1hdkuop</bpmn:incoming>
          <bpmn:outgoing>Flow_0t26nvw</bpmn:outgoing>
          <bpmn:outgoing>Flow_0lx0ky8</bpmn:outgoing>
        </bpmn:parallelGateway>
        <bpmn:serviceTask id="getFileContent" name="Get file content">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
            <zeebe:ioMapping>
              <zeebe:input source="bearer" target="authentication.type" />
              <zeebe:input source="=webModelerToken" target="authentication.token" />
              <zeebe:input source="GET" target="method" />
              <zeebe:input source="=modelerBaseUrl + &#34;/api/v1/files/&#34; + file.id" target="url" />
              <zeebe:input source="20" target="connectionTimeoutInSeconds" />
              <zeebe:input source="20" target="readTimeoutInSeconds" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={content: response.body.content}" />
              <zeebe:header key="retryBackoff" value="PT0S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_0lx0ky8</bpmn:incoming>
          <bpmn:outgoing>Flow_1jonoiv</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:task id="getLatestMilestone" name="Get latest milestone">
          <bpmn:incoming>Flow_0y214bj</bpmn:incoming>
          <bpmn:outgoing>Flow_0mnyxys</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="splitHasMilestone" name="has previous milestone to compare against?" default="Flow_12k5ck5">
          <bpmn:incoming>Flow_0mnyxys</bpmn:incoming>
          <bpmn:outgoing>Flow_0zp499b</bpmn:outgoing>
          <bpmn:outgoing>Flow_12k5ck5</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="getMilestoneComparisonLink" name="Get milestone comparison link">
          <bpmn:incoming>Flow_0zp499b</bpmn:incoming>
          <bpmn:outgoing>Flow_1vv9nsa</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="Flow_0t26nvw" sourceRef="splitCallWebModeler" targetRef="createMilestone" />
        <bpmn:sequenceFlow id="Flow_0lx0ky8" sourceRef="splitCallWebModeler" targetRef="getFileContent" />
        <bpmn:sequenceFlow id="Flow_1jonoiv" sourceRef="getFileContent" targetRef="endRetrieveFileContent" />
        <bpmn:sequenceFlow id="Flow_0zp499b" name="yes" sourceRef="splitHasMilestone" targetRef="getMilestoneComparisonLink">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=latestMilestoneId != null</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_1hdkuop" sourceRef="startFileMetadataSubprocess" targetRef="splitCallWebModeler" />
        <bpmn:sequenceFlow id="Flow_1vv9nsa" sourceRef="getMilestoneComparisonLink" targetRef="endNoMilestoneC" />
        <bpmn:sequenceFlow id="Flow_12k5ck5" name="no" sourceRef="splitHasMilestone" targetRef="endMilestoneComparison" />
        <bpmn:exclusiveGateway id="splitIsDmn" name="is DMN?" default="Flow_0y214bj">
          <bpmn:incoming>Flow_0qwhjkc</bpmn:incoming>
          <bpmn:outgoing>Flow_0y214bj</bpmn:outgoing>
          <bpmn:outgoing>Flow_1hf73xs</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0y214bj" name="no" sourceRef="splitIsDmn" targetRef="getLatestMilestone" />
        <bpmn:sequenceFlow id="Flow_1hf73xs" name="yes" sourceRef="splitIsDmn" targetRef="endNoDmnMilestoneComparison">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=file.type = "DMN"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:endEvent id="endRetrieveFileContent" name="Retrieved file content">
          <bpmn:incoming>Flow_1jonoiv</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="endMilestoneComparison" name="milestone comparison created">
          <bpmn:incoming>Flow_12k5ck5</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="endNoMilestoneC" name="no milestone to compare against">
          <bpmn:incoming>Flow_1vv9nsa</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="endNoDmnMilestoneComparison" name="no milestone comparison for DMN">
          <bpmn:incoming>Flow_1hf73xs</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_0mnyxys" sourceRef="getLatestMilestone" targetRef="splitHasMilestone" />
