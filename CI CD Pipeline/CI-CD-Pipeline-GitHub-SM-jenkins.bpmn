          <bpmn:incoming>Flow_0t26nvw</bpmn:incoming>
          <bpmn:outgoing>Flow_0qwhjkc</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="Flow_0qwhjkc" sourceRef="createMilestone" targetRef="splitIsDmn" />
      </bpmn:subProcess>
