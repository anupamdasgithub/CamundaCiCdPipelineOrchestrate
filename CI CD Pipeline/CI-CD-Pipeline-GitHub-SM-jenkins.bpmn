      <bpmn:serviceTask id="Activity_0hgulym" name="Trigger Jenkins dev build">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="basic" target="authentication.type" />
            <zeebe:input source="{{ secrets.JENKINS_USER }}" target="authentication.username" />
            <zeebe:input source="{{ secrets.JENKINS_TOKEN }}" target="authentication.password" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=jenkinsBaseUrl + &#34;/job/&#34; + jenkinsJob + &#34;/buildWithParameters&#34;" target="url" />
            <zeebe:input source="={&#34;ENVIRONMENT&#34;: &#34;dev&#34;, &#34;FOLDER&#34;: folder.metadata.name, &#34;CORRELATION_TOKEN&#34;: string(createdMergeRequest.number)}" target="queryParameters" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultExpression" value="={devJenkinsBuild: {status: response.status}}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_18ymcs4</bpmn:incoming>
        <bpmn:outgoing>Flow_0ly1pmk</bpmn:outgoing>
      </bpmn:serviceTask>
